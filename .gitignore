.vscode/

# Claude Code (personal, per-developer settings)
.claude/settings.json
.claude/settings.local.json

# Generated output. A run writes everything into --outdir, which defaults to ./out.
out/
# ...and these cover a run pointed somewhere else, e.g. --outdir .
*.ezt.artifacts.json
*.ezt.lineage.json
*.ezt.prefetch.json
*.ezt.fetch.json

# NOTE: goldens/, examples/ and tests/fixtures/ are deliberately NOT ignored. The goldens
# are the byte-stability ratchet, the shipped macro members are what the examples resolve
# against, and the committed JCL lineage view is this repository's half of a
# cross-repository contract - all three are worthless if they are not tracked.
# tests/fixtures/payroll.jcl.lineage.json in particular is NOT run output, despite looking
# like it: it is regenerated deliberately by tools/refresh_fixture.py.
